{
  "name": "jimlang-vscode",
  "displayName": "JimLang",
  "description": "LSP client for JimLang",
  "version": "0.0.1",
  "publisher": "jimlang",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:jimlang"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jimlang.restart",
        "title": "JimLang: Restart Language Server"
      }
    ],
    "grammars": [
      {
        "language": "jimlang",
        "scopeName": "source.jimlang",
        "path": "./syntaxes/jimlang.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "jimlang",
        "aliases": [
          "JimLang",
          "jimlang"
        ],
        "extensions": [
          ".jim",
          ".mylang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "JimLang",
      "properties": {
        "jimlang.lsp.jarPath": {
          "type": "string",
          "default": "${workspaceFolder}/target/jimlang-1.0-SNAPSHOT-jar-with-dependencies.jar",
          "description": "Path to jimlang fat jar that contains the LSP server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.4.0",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}