# =============================================================================
# 简易 Agent 框架 · CatBase 完整版（面向官方 catbasecc）
# -----------------------------------------------------------------------------
# 与 agent_llm_demo.cat 同一套“领域无关”设计：
#   框架 = agent loop + 意图识别 + memory(短/长时) + context 组装 + 行动层
#   业务 = 仅通过“行动层(run_tool)”挂接；这里示例挂“待办清单(todo)”，
#          换成你的领域只需替换 run_tool 的分支与 tools_doc()。
# 差异：官方版用 规则大脑(离线) + input 交互 + File/JSON 持久化；
#       接入真实 LLM 时把 detect_brain 换成 http_post 调用即可（见文章第 6 节）。
# =============================================================================

MEM_FILE: str = "agent_memory.json"
TODO_FILE: str = "todo.json"

# ---------------------------------------------------------------------------
# 字符串基础件（用官方示例验证过的切片语法 s[i:j] 实现）
# ---------------------------------------------------------------------------

def sub_pos(s: str, sub: str) -> int {
    n: int = len(s)
    k: int = len(sub)
    if k == 0 {
        return 0
    }
    if k > n {
        return -1
    }
    for i in range(0, n - k + 1) {
        part: str = s[i:i + k]
        if part == sub {
            return i
        }
    }
    return -1
}

def extract_number(msg: str) -> int {
    digit: str = ""
    for i in range(0, len(msg)) {
        ch: str = msg[i:i + 1]
        if ch >= "0" {
            if ch <= "9" {
                digit = digit + ch
            }
        }
    }
    if digit == "" {
        return 0
    }
    return int(digit)
}

# ---------------------------------------------------------------------------
# 行动层（示例领域：待办清单；替换这里 = 换成你的业务）
# ---------------------------------------------------------------------------

def new_todos() -> dict[str, any] {
    return { "next_id": 1, "items": [] }
}

def load_todos(path: str) -> dict[str, any] {
    f: File = file(path, "r")
    content: str = f.read()
    f.close()
    if content == "" {
        return new_todos()
    }
    raw: dict[str, any] = json_loads(content)
    try {
        _t: any = raw["items"]
    } except {
        raw["items"] = []
    }
    return raw
}

def save_todos(t: dict[str, any], path: str) {
    fw: File = file(path, "w")
    fw.write(json_dumps(t))
    fw.close()
}

def todo_add(t: dict[str, any], text: str) -> str {
    nid: int = int(str(t.get("next_id", 1)))
    item: dict[str, any] = {}
    item["id"] = nid
    item["text"] = text
    item["done"] = false
    t["items"].append(item)
    t["next_id"] = nid + 1
    return "已添加待办 #" + str(nid) + "：" + text
}

def find_item(t: dict[str, any], nid: int) -> int {
    items: list[any] = t["items"]
    for i in range(0, len(items)) {
        it: dict[str, any] = items[i]
        if int(str(it.get("id", 0))) == nid {
            return i
        }
    }
    return -1
}

def todo_list(t: dict[str, any]) -> str {
    items: list[any] = t["items"]
    if len(items) == 0 {
        return "当前没有待办"
    }
    out: str = ""
    for i in range(0, len(items)) {
        it: dict[str, any] = items[i]
        mark: str = "x"
        if int(str(it.get("done", 0))) == 0 {
            mark = " "
        }
        out = out + "[" + mark + "] #" + str(it.get("id", 0)) + " " + str(it.get("text", "")) + "\n"
    }
    return out
}

def todo_done(t: dict[str, any], nid: int) -> str {
    idx: int = find_item(t, nid)
    if idx < 0 {
        return "没有编号 " + str(nid) + " 的待办"
    }
    it: dict[str, any] = t["items"][idx]
    it["done"] = true
    return "已完成 #" + str(nid) + "：" + str(it.get("text", ""))
}

def todo_del(t: dict[str, any], nid: int) -> str {
    idx: int = find_item(t, nid)
    if idx < 0 {
        return "没有编号 " + str(nid) + " 的待办"
    }
    it: dict[str, any] = t["items"][idx]
    t["items"].pop(idx)
    return "已删除 #" + str(nid) + "：" + str(it.get("text", ""))
}

# ---------------------------------------------------------------------------
# 大脑：规则版 detect_brain（离线、可解释）；换 LLM 时替换本函数
# ---------------------------------------------------------------------------

def detect_brain(user_msg: str) -> dict[str, any] {
    act: dict[str, any] = {}
    if sub_pos(user_msg, "记") >= 0 {
        if sub_pos(user_msg, "待办") >= 0 {
            act["intent"] = "todo_add"
            act["text"] = sub_after(user_msg, "：")
            if str(act["text"]) == "" {
                act["text"] = sub_after(user_msg, "记")
            }
            return act
        }
    }
    if sub_pos(user_msg, "清单") >= 0 {
        act["intent"] = "todo_list"
        return act
    }
    if sub_pos(user_msg, "完成") >= 0 {
        act["intent"] = "todo_done"
        act["id"] = extract_number(user_msg)
        return act
    }
    if sub_pos(user_msg, "删") >= 0 {
        act["intent"] = "todo_del"
        act["id"] = extract_number(user_msg)
        return act
    }
    if sub_pos(user_msg, "再见") >= 0 {
        act["intent"] = "bye"
        act["say"] = "再见！"
        return act
    }
    act["intent"] = "help"
    act["say"] = "我可以帮你记待办。试试：记一条待办：xxx / 看看清单 / 完成第 1 条 / 删第 1 条"
    return act
}

def sub_after(s: str, kw: str) -> str {
    p: int = sub_pos(s, kw)
    if p < 0 {
        return ""
    }
    return s[p + 1:len(s)]
}

def run_tool(t: dict[str, any], act: dict[str, any]) -> str {
    name: str = str(act["intent"])
    if name == "todo_add" {
        return todo_add(t, str(act["text"]))
    }
    if name == "todo_list" {
        return todo_list(t)
    }
    if name == "todo_done" {
        return todo_done(t, int(str(act["id"])))
    }
    if name == "todo_del" {
        return todo_del(t, int(str(act["id"])))
    }
    return ""
}

def generate_reply(act: dict[str, any], result: str) -> str {
    name: str = str(act["intent"])
    if result != "" {
        return result
    }
    return str(act.get("say", "没太明白，再说一次？"))
}

# ---------------------------------------------------------------------------
# 记忆（memory）与上下文（context）
# ---------------------------------------------------------------------------

def new_memory() -> dict[str, any] {
    return { "facts": [], "history": [] }
}

def load_memory(path: str) -> dict[str, any] {
    f: File = file(path, "r")
    content: str = f.read()
    f.close()
    if content == "" {
        return new_memory()
    }
    raw: dict[str, any] = json_loads(content)
    try {
        _t: any = raw["facts"]
    } except {
        raw["facts"] = []
    }
    try {
        _t2: any = raw["history"]
    } except {
        raw["history"] = []
    }
    return raw
}

def save_memory(mem: dict[str, any], path: str) {
    fw: File = file(path, "w")
    fw.write(json_dumps(mem))
    fw.close()
}

def remember(mem: dict[str, any], role: str, text: str) {
    turn: dict[str, any] = { "role": role, "text": text }
    mem["history"].append(turn)
    if len(mem["history"]) > 6 {
        keep: list[any] = []
        h: list[any] = mem["history"]
        start: int = len(h) - 6
        for i in range(start, len(h)) {
            keep.append(h[i])
        }
        mem["history"] = keep
    }
}

def build_context(mem: dict[str, any], act: dict[str, any], result: str) -> str {
    ctx: str = "【系统】你是通用 agent“小助手”。\n【长期记忆】\n"
    fs: list[any] = mem["facts"]
    for i in range(0, len(fs)) {
        ctx = ctx + "  - " + str(fs[i]) + "\n"
    }
    ctx = ctx + "【最近对话】\n"
    h: list[any] = mem["history"]
    for i in range(0, len(h)) {
        t: dict[str, any] = h[i]
        ctx = ctx + "  " + str(t["role"]) + ": " + str(t["text"]) + "\n"
    }
    ctx = ctx + "【本轮】intent=" + str(act["intent"]) + "，工具返回=" + result + "\n"
    return ctx
}

# ---------------------------------------------------------------------------
# agent loop
# ---------------------------------------------------------------------------

def run_turn(t: dict[str, any], mem: dict[str, any], user_msg: str) -> str {
    remember(mem, "user", user_msg)
    act: dict[str, any] = detect_brain(user_msg)
    result: str = run_tool(t, act)
    ctx: str = build_context(mem, act, result)
    print("── 本轮上下文 ──────────────────────────\n")
    print(ctx)
    print("────────────────────────────────────────\n")
    reply: str = generate_reply(act, result)
    remember(mem, "assistant", reply)
    return reply
}

def main(args: list[str]) {
    t: dict[str, any] = new_todos()
    mem: dict[str, any] = new_memory()
    try {
        t = load_todos(TODO_FILE)
        mem = load_memory(MEM_FILE)
        print("已恢复待办与记忆\n")
    } except {
        t = new_todos()
        mem = new_memory()
    }

    print("========== 小助手（CatBase Agent · 领域无关）==========\n")
    print("直接说需求：记一条待办：xxx / 看看清单 / 完成第 1 条 / 删第 1 条 / 再见\n")

    while true {
        user_msg: str = input("你：")
        if user_msg == "" {
            continue
        }
        act: dict[str, any] = detect_brain(user_msg)
        if str(act["intent"]) == "bye" {
            save_todos(t, TODO_FILE)
            save_memory(mem, MEM_FILE)
            print("小助手：再见（已保存待办与记忆）\n")
            break
        }
        reply: str = run_turn(t, mem, user_msg)
        print("小助手：", reply, "\n")
    }
}
