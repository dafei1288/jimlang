# =============================================================================
# 简易 Agent 框架 · 领域无关脚手架 (可直接用 jimlang 运行)
# -----------------------------------------------------------------------------
# 这份文件刻意“不绑定任何业务领域”：只演示 agent 框架本体 ——
#   agent loop / memory(短时+长时) / context 组装 / 大脑接口占位
# 大脑有两个实现（接口相同，可插拔）：
#   1) 本文件：规则大脑（离线、确定性，适合当脚手架/回归基线）
#   2) agent_llm_demo.cat：真实 LLM 大脑（ask_llm，已实测）
# 业务工具怎么挂？看 agent_llm_demo.cat 的 tools 部分——换成任何领域即可，
# 框架代码一行都不用改。
# =============================================================================

# ---------------------------------------------------------------------------
# 记忆：短时 history（自动裁剪）+ 长时 facts（去重）
# ---------------------------------------------------------------------------

def new_memory() -> dict[str, any] {
    return {
        "facts": [],
        "history": []
    }
}

def remember(mem: dict[str, any], role: str, text: str) {
    turn: dict[str, any] = { "role": role, "text": text }
    append(mem["history"], turn)
    # 短时记忆翻页：只保留最近 6 条
    if len(mem["history"]) > 6 {
        keep: list[any] = []
        h: list[any] = mem["history"]
        start: int = len(h) - 6
        for i in range(start, len(h)) {
            append(keep, h[i])
        }
        mem["history"] = keep
    }
}

def note_fact(mem: dict[str, any], fact: str) {
    fs: list[any] = mem["facts"]
    exists: bool = false
    for i in range(0, len(fs)) {
        if str(fs[i]) == fact {
            exists = true
        }
    }
    if not exists {
        append(mem["facts"], fact)
    }
}

# ---------------------------------------------------------------------------
# 大脑接口的两个实现之「规则版」：这里只做极简分类，便于演示管道。
# 换 LLM 时替换 detect_brain() 即可（参数/返回完全一致）。
# ---------------------------------------------------------------------------

def detect_brain(user_msg: str) -> dict[str, any] {
    act: dict[str, any] = {}
    if user_msg.contains("你好") {
        act["intent"] = "hello"
        act["say"] = "你好！我是规则大脑版的 agent 脚手架。问我“你是谁”或说“再见”试试。"
        return act
    }
    if user_msg.contains("你是谁") {
        act["intent"] = "who"
        act["say"] = "我是一个 agent 框架示例：有循环、有记忆、有上下文，大脑可以被替换成 LLM（见 agent_llm_demo.cat）。"
        return act
    }
    if user_msg.contains("再见") {
        act["intent"] = "bye"
        act["say"] = "再见，下次见！"
        return act
    }
    act["intent"] = "help"
    act["say"] = "我能听懂的不多：你好 / 你是谁 / 再见。完整能力请看 LLM 大脑版。"
    return act
}

def run_tool(mem: dict[str, any], act: dict[str, any]) -> str {
    # 框架的行动层：规则大脑没有外部工具，返回空字符串表示“纯对话”
    return ""
}

def build_context(mem: dict[str, any], act: dict[str, any], result: str) -> str {
    ctx: str = "【系统】你是 agent 框架示例。\n"
    ctx = ctx + "【长期记忆】\n"
    fs: list[any] = mem["facts"]
    for i in range(0, len(fs)) {
        ctx = ctx + "  - " + str(fs[i]) + "\n"
    }
    ctx = ctx + "【最近对话】\n"
    h: list[any] = mem["history"]
    for i in range(0, len(h)) {
        t: dict[str, any] = h[i]
        ctx = ctx + "  " + str(t["role"]) + ": " + str(t["text"]) + "\n"
    }
    ctx = ctx + "【本轮】intent=" + str(act["intent"]) + "，工具返回=" + result + "\n"
    return ctx
}

# ---------------------------------------------------------------------------
# agent loop：一轮 = 记忆 -> 大脑决策 -> 行动 -> 上下文 -> 回复 -> 记忆
# ---------------------------------------------------------------------------

def run_turn(mem: dict[str, any], user_msg: str) -> str {
    remember(mem, "user", user_msg)

    act: dict[str, any] = detect_brain(user_msg)   # ← 大脑（可替换）
    result: str = run_tool(mem, act)               # ← 行动
    ctx: str = build_context(mem, act, result)     # ← 上下文

    print("── 大脑看到的上下文 ──────────────────────\n")
    print(ctx)
    print("──────────────────────────────────────────\n")

    reply: str = str(act["say"])
    remember(mem, "assistant", reply)
    return reply
}

def main(args: list[str]) {
    mem: dict[str, any] = new_memory()
    print("========== Agent 脚手架（规则大脑 · 领域无关） ==========\n")

    msgs: list[any] = ["你好", "你是谁", "再见了"]
    for i in range(0, len(msgs)) {
        m: str = str(msgs[i])
        print(">>> 用户：", m, "\n")
        reply: str = run_turn(mem, m)
        print("<<< 助手：", reply, "\n\n")
    }

    print("========== 记忆快照 ==========\n")
    fs: list[any] = mem["facts"]
    for i in range(0, len(fs)) {
        print("  - ", fs[i], "\n")
    }
    h: list[any] = mem["history"]
    for i in range(0, len(h)) {
        t: dict[str, any] = h[i]
        print("  ", t["role"], ": ", t["text"], "\n")
    }
    print("（无外部业务工具 —— 想看工具调用，运行 agent_llm_demo.cat）\n")
}
