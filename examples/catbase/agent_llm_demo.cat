# =============================================================================
# 简易 Agent 框架 · LLM 大脑版 (可直接用 JimLang 运行，已实测)
# -----------------------------------------------------------------------------
# 领域无关：框架代码与“业务”完全分离，这里只挂一个最小的示例工具
# “待办清单(todo)”——换成你的领域(查询/下单/写文件/调 API)时，只需替换
# “工具层”与 brain_prompt 里的工具说明，框架(loop/memory/context/llm)不动。
# 每轮：
#   1) 工具说明 + 长期记忆 + 最近对话 + 本轮用户 -> prompt -> ask_llm
#   2) 模型输出一行 JSON 动作，例如 {"intent":"todo_add","text":"周三交周报"}
#   3) 框架执行对应工具；工具结果再让模型润色成人话
#   4) 写入记忆(history/facts)
# 前置：export LLM_API_KEY=... 或项目根目录 .env 写 LLM_API_KEY=sk-...
# =============================================================================

LLM_OPTS: dict[str, any] = {
    "model": "deepseek-chat",
    "temperature": 0.1,
    "print": false
}

# ---------------------------------------------------------------------------
# 工具层（示例领域：待办清单）—— 替换这里 = 换成你的业务
# ---------------------------------------------------------------------------

def new_todos() -> dict[str, any] {
    return { "next_id": 1, "items": [] }
}

def todo_add(t: dict[str, any], text: str) -> str {
    nid: int = t["next_id"]
    item: dict[str, any] = { "id": nid, "text": text, "done": false }
    append(t["items"], item)
    t["next_id"] = nid + 1
    return "已添加待办 #" + str(nid) + "：" + text
}

def todo_list(t: dict[str, any]) -> str {
    items: list[any] = t["items"]
    if len(items) == 0 {
        return "当前没有待办"
    }
    out: str = ""
    for i in range(0, len(items)) {
        it: dict[str, any] = items[i]
        mark: str = "x"
        if not it["done"] {
            mark = " "
        }
        out = out + "[" + mark + "] #" + str(it["id"]) + " " + str(it["text"]) + "\n"
    }
    return out
}

def todo_done(t: dict[str, any], nid: int) -> str {
    items: list[any] = t["items"]
    for i in range(0, len(items)) {
        it: dict[str, any] = items[i]
        if it["id"] == nid {
            if it["done"] {
                return "#" + str(nid) + " 已完成过了"
            }
            it["done"] = true
            return "已完成 #" + str(nid) + "：" + str(it["text"])
        }
    }
    return "没有编号 " + str(nid) + " 的待办"
}

def todo_del(t: dict[str, any], nid: int) -> str {
    items: list[any] = t["items"]
    for i in range(0, len(items)) {
        it: dict[str, any] = items[i]
        if it["id"] == nid {
            keep: list[any] = []
            for j in range(0, len(items)) {
                if items[j] != it {
                    append(keep, items[j])
                }
            }
            t["items"] = keep
            return "已删除 #" + str(nid) + "：" + str(it["text"])
        }
    }
    return "没有编号 " + str(nid) + " 的待办"
}

# ---------------------------------------------------------------------------
# 记忆
# ---------------------------------------------------------------------------

def new_memory() -> dict[str, any] {
    return { "facts": [], "history": [] }
}

def remember(mem: dict[str, any], role: str, text: str) {
    turn: dict[str, any] = { "role": role, "text": text }
    append(mem["history"], turn)
    if len(mem["history"]) > 8 {
        keep: list[any] = []
        h: list[any] = mem["history"]
        start: int = len(h) - 8
        for i in range(start, len(h)) {
            append(keep, h[i])
        }
        mem["history"] = keep
    }
}

def note_fact(mem: dict[str, any], fact: str) {
    fs: list[any] = mem["facts"]
    exists: bool = false
    for i in range(0, len(fs)) {
        if str(fs[i]) == fact {
            exists = true
        }
    }
    if not exists {
        append(mem["facts"], fact)
    }
}

# ---------------------------------------------------------------------------
# 大脑：build prompt -> ask_llm -> 解析 JSON 动作
# ---------------------------------------------------------------------------

def tools_doc() -> str {
    d: str = "可用工具（用一行 JSON 表示动作，不要多余文字）：\n"
    d = d + "- {\"intent\":\"todo_add\",\"text\":\"事项内容\"} 新增待办\n"
    d = d + "- {\"intent\":\"todo_list\"} 查看全部待办\n"
    d = d + "- {\"intent\":\"todo_done\",\"id\":编号} 把某条待办标记完成\n"
    d = d + "- {\"intent\":\"todo_del\",\"id\":编号} 删除某条待办\n"
    d = d + "- {\"intent\":\"chat\",\"say\":\"自然回复\"} 闲聊/打招呼/无法理解或无需工具时使用\n"
    return d
}

def brain_prompt(mem: dict[str, any], user_msg: str) -> str {
    p: str = "你是“小助手”，一个通用 agent。\n"
    p = p + tools_doc()
    p = p + "规则：只输出一行 JSON，不要代码块与解释；涉及编号时尽量用列表里的真实编号。\n"
    p = p + "\n【长期记忆】\n"
    fs: list[any] = mem["facts"]
    for i in range(0, len(fs)) {
        p = p + "- " + str(fs[i]) + "\n"
    }
    p = p + "【最近对话】\n"
    h: list[any] = mem["history"]
    for i in range(0, len(h)) {
        t: dict[str, any] = h[i]
        p = p + str(t["role"]) + ": " + str(t["text"]) + "\n"
    }
    p = p + "【本轮用户】" + user_msg + "\n"
    p = p + "只输出 JSON："
    return p
}

def parse_action(raw: str) -> dict[str, any] {
    text: str = raw
    if text.startsWith("```") {
        pos: int = indexOf(text, "\n")
        if pos >= 0 {
            text = substring(text, pos + 1)
        }
        end: int = indexOf(text, "```")
        if end >= 0 {
            text = substring(text, 0, end)
        }
    }
    trimmed: str = trim(text)
    act: dict[str, any] = {}
    if trimmed.startsWith("{") {
        act = json_loads(trimmed)
    } else {
        act["intent"] = "chat"
        act["say"] = trimmed
    }
    return act
}

# ---------------------------------------------------------------------------
# 行动层：intent -> 工具（换成你的业务就在这里加分支）
# ---------------------------------------------------------------------------

def run_tool(t: dict[str, any], act: dict[str, any]) -> str {
    intent: str = str(act.get("intent", "chat"))
    if intent == "todo_add" {
        return todo_add(t, str(act.get("text", "")))
    }
    if intent == "todo_list" {
        return todo_list(t)
    }
    if intent == "todo_done" {
        return todo_done(t, int(str(act.get("id", 0))))
    }
    if intent == "todo_del" {
        return todo_del(t, int(str(act.get("id", 0))))
    }
    return ""   # chat：无工具动作
}

def llm(opts: dict[str, any], prompt: str) -> str {
    return str(ask_llm(prompt, opts))
}

# ---------------------------------------------------------------------------
# agent loop
# ---------------------------------------------------------------------------

def run_turn(t: dict[str, any], mem: dict[str, any], user_msg: str) -> str {
    remember(mem, "user", user_msg)

    print("┌─ 思考中(ask_llm) ─────────────────────\n")
    act_raw: str = llm(LLM_OPTS, brain_prompt(mem, user_msg))
    print("│ 模型输出：", act_raw, "\n")
    act: dict[str, any] = parse_action(act_raw)
    intent: str = str(act.get("intent", "chat"))
    print("│ 决策：intent=", intent, "\n")

    result: str = run_tool(t, act)
    if result != "" {
        print("│ 工具返回：", result, "\n")
    }

    reply: str = ""
    if result == "" {
        reply = str(act.get("say", act_raw))
    } else {
        polish: str = "你是小助手。工具执行结果：\n" + result + "\n请用一句自然中文转述给用户，不要编造，不要提 JSON。"
        reply = llm(LLM_OPTS, polish)
    }
    print("└─────────────────────────────────────────\n")

    remember(mem, "assistant", reply)
    return reply
}

# ---------------------------------------------------------------------------
# key 预检：ask_llm 取 key 顺序 LLM_API_KEY -> API_KEY -> DEEPSEEK_API_KEY
# ---------------------------------------------------------------------------

def key_tail(k: str) -> str {
    n: int = len(k)
    if n <= 4 {
        return k
    }
    return substring(k, n - 4, n)
}

def check_key() -> str {
    load_env(".env", true)
    k: str = ""
    src: str = ""
    k = str(env_get("LLM_API_KEY", ""))
    if k != "" {
        src = "LLM_API_KEY"
    }
    if k == "" {
        k = str(env_get("API_KEY", ""))
        if k != "" {
            src = "API_KEY"
        }
    }
    if k == "" {
        k = str(env_get("DEEPSEEK_API_KEY", ""))
        if k != "" {
            src = "DEEPSEEK_API_KEY"
        }
    }
    if k == "" {
        print("未检测到 API key。任选其一后重试：\n")
        print("  export LLM_API_KEY=sk-...\n")
        print("  或在项目根目录创建 .env 写入 LLM_API_KEY=sk-...\n")
        return ""
    }
    print("将使用 ", src, " 中的 key（尾号 ...", key_tail(k), "）\n")
    return k
}

def main(args: list[str]) {
    if check_key() == "" {
        return
    }
    t: dict[str, any] = new_todos()
    mem: dict[str, any] = new_memory()

    print("========== 小助手 · Agent（LLM 大脑 · 领域无关） ==========\n")
    print("（挂载示例工具：待办清单；换成你的业务只改 run_tool 与工具说明）\n")

    msgs: list[any] = [
        "你好",
        "帮我记一条待办：周三交周报",
        "再看看我的待办",
        "把第 1 条完成掉",
        "删掉第 2 条",
        "谢谢，再见"
    ]

    for i in range(0, len(msgs)) {
        m: str = str(msgs[i])
        print(">>> 用户：", m, "\n")
        reply: str = run_turn(t, mem, m)
        print("<<< 助手：", reply, "\n\n")
        if m.contains("再见") {
            break
        }
    }

    print("========== 记忆快照 ==========\n")
    fs: list[any] = mem["facts"]
    for i in range(0, len(fs)) {
        print("  - ", fs[i], "\n")
    }
    h: list[any] = mem["history"]
    for i in range(0, len(h)) {
        it: dict[str, any] = h[i]
        print("  ", it["role"], ": ", it["text"], "\n")
    }
    print("【工具域 JSON】\n", json_dumps(t), "\n")
}
